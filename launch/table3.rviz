Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Global Options:
    Fixed Frame: world
    Frame Rate: 30
    Background Color: 30; 30; 30
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 50
    - Class: rviz_default_plugins/PointCloud2
      Name: Scene
      Enabled: true
      Topic:
        Value: /global_pc
        Reliability Policy: Best Effort
        Durability Policy: Volatile
      Size (m): 0.06
      Style: Points
      Color Transformer: FlatColor
      Color: 170; 170; 170
    - Class: rviz_default_plugins/PointCloud2
      Name: LiDAR
      Enabled: true
      Topic:
        Value: /cloud_registered
        Reliability Policy: Best Effort
        Durability Policy: Volatile
      Size (m): 0.035
      Style: Points
      Color Transformer: FlatColor
      Color: 80; 220; 200
    - Class: rviz_default_plugins/Marker
      Name: Drone
      Enabled: true
      Marker Topic:
        Value: /robot
        Reliability Policy: Best Effort
    - Class: rviz_default_plugins/Path
      Name: Executed trajectory
      Enabled: true
      Topic:
        Value: /path
        Reliability Policy: Best Effort
      Color: 255; 220; 70
      Line Style: Lines
      Line Width: 0.04
    - Class: rviz_default_plugins/Marker
      Name: Reference paths
      Enabled: true
      Marker Topic:
        Value: /corto/filter_path
    - Class: rviz_default_plugins/Marker
      Name: NMPC prediction
      Enabled: true
      Marker Topic:
        Value: /corto/predict_traj
    - Class: rviz_default_plugins/MarkerArray
      Name: Continuous corridor
      Enabled: true
      Marker Topic:
        Value: /corto/corridor_markers
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 35
      Pitch: 0.8
      Yaw: 0.5
      Focal Point:
        X: 0
        Y: 0
        Z: 1.5
Window Geometry:
  Width: 1440
  Height: 900
